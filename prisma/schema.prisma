// Soccer Talent Platform — Prisma schema
// See docs/brief.md for the product requirements this schema implements.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Role {
  PLAYER
  AGENT
  ADMIN
}

enum ExperienceLevel {
  AMATEUR
  SEMI_PRO
  PROFESSIONAL
}

enum Position {
  GOALKEEPER
  CENTER_BACK
  FULL_BACK
  DEFENSIVE_MIDFIELDER
  CENTRAL_MIDFIELDER
  ATTACKING_MIDFIELDER
  WINGER
  STRIKER
  FORWARD
}

enum ModerationStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED
}

enum VideoPlatform {
  YOUTUBE
  VIMEO
}

enum VideoCategory {
  HIGHLIGHTS
  SKILLS
  TRAINING
}

enum SubscriptionPlan {
  BASIC
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum AttachmentType {
  PDF
  IMAGE
}

enum NotificationType {
  NEW_MESSAGE
  SHORTLIST_ADD
  PROFILE_APPROVED
  PROFILE_FLAGGED
  SYSTEM
}

// ── Auth.js (NextAuth) models ───────────────────────────────────────────
// https://authjs.dev/getting-started/adapters/prisma

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Core user & profiles ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String
  role          Role      @default(PLAYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  playerProfile PlayerProfile?
  agentProfile  AgentProfile?

  notes            Note[]
  savedSearches    SavedSearch[]
  shortlists       Shortlist[]
  sentMessages     Message[]                 @relation("MessageSender")
  conversations    ConversationParticipant[]
  notifications    Notification[]
  subscription     Subscription?
  moderatedContent Video[]                   @relation("VideoModeratedBy")

  @@index([role])
}

model PlayerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal info (§1) — nullable: filled in when the player completes their CV
  dateOfBirth DateTime?
  heightCm    Int?
  weightKg    Int?
  nationality String?
  location    String?

  // Position & play style (§1)
  positions Position[]
  playStyle String?    @db.Text

  // Team history / experience (§1)
  experienceLevel ExperienceLevel @default(AMATEUR)

  // Availability (§1)
  openToTrials   Boolean @default(true)
  openToTransfer Boolean @default(true)

  bio String? @db.Text

  // Membership-gated video limits enforced in application logic
  moderationStatus ModerationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  careerStats  CareerStat[]
  achievements Achievement[]
  videos       Video[]
  teamHistory  TeamHistoryEntry[]

  shortlistEntries ShortlistPlayer[]
  notes            Note[]

  @@index([nationality])
  @@index([experienceLevel])
  @@index([openToTrials, openToTransfer])
}

model CareerStat {
  id              String        @id @default(cuid())
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  season        String // e.g. "2024/2025"
  club          String
  goals         Int    @default(0)
  assists       Int    @default(0)
  appearances   Int    @default(0)
  minutesPlayed Int    @default(0)
  cleanSheets   Int    @default(0)

  createdAt DateTime @default(now())

  @@index([playerProfileId])
}

model Achievement {
  id              String        @id @default(cuid())
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  year        Int?

  createdAt DateTime @default(now())

  @@index([playerProfileId])
}

model Video {
  id              String        @id @default(cuid())
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  title    String
  url      String
  platform VideoPlatform
  category VideoCategory

  moderationStatus ModerationStatus @default(PENDING)
  moderatedById    String?
  moderatedBy      User?            @relation("VideoModeratedBy", fields: [moderatedById], references: [id])

  createdAt DateTime @default(now())

  @@index([playerProfileId])
}

model TeamHistoryEntry {
  id              String        @id @default(cuid())
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  clubName    String
  level       ExperienceLevel
  startDate   DateTime
  endDate     DateTime?
  description String?         @db.Text

  @@index([playerProfileId])
}

model AgentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationName String?
  title            String? // e.g. "Scout", "Club representative"
  phone            String?
  verified         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Agent tools (§2) ─────────────────────────────────────────────────────

model Shortlist {
  id      String @id @default(cuid())
  agentId String
  agent   User   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players ShortlistPlayer[]

  @@index([agentId])
}

model ShortlistPlayer {
  id              String        @id @default(cuid())
  shortlistId     String
  shortlist       Shortlist     @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([shortlistId, playerProfileId])
  @@index([playerProfileId])
}

model Note {
  id              String        @id @default(cuid())
  authorId        String
  author          User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Private: only visible to `author` — enforced in application logic.
  @@index([authorId])
  @@index([playerProfileId])
}

model SavedSearch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  filters Json // position(s), age range, country, location, skill level, height/weight, stats, availability

  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Messaging (§5) ───────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  content String    @db.Text
  readAt  DateTime?

  createdAt DateTime @default(now())

  attachments Attachment[]

  @@index([conversationId])
  @@index([senderId])
}

model Attachment {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  url      String
  filename String
  type     AttachmentType

  createdAt DateTime @default(now())

  @@index([messageId])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  content String
  link    String?
  read    Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ── Membership & billing (§6) ────────────────────────────────────────────

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan   @default(BASIC)
  status SubscriptionStatus @default(ACTIVE)

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
